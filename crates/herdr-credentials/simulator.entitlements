<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Keychain access group the simulator grants this crate's test binary,
  read from its __TEXT,__entitlements section (src/device_key/tests/keychain.rs).
  The team prefix is a placeholder: the simulator does not check it, and no
  device build uses this file.
-->
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>HERDRTEST.dev.herdr.gpui.credentials-tests</string>
	<key>keychain-access-groups</key>
	<array>
		<string>HERDRTEST.dev.herdr.gpui.credentials-tests</string>
	</array>
</dict>
</plist>
