new file mode 100644
index 0000000..fe6fd86
--- /dev/null
+++ b/src/key_routing.rs
@@ -0,0 +1,34 @@
+//! Which hardware keys must reach UIKit before GPUI bindings and terminals.
+use gpui::Keystroke;
+
+pub(crate) fn uikit_first(
+    key: &Keystroke,
+    composing: impl FnOnce() -> bool,
+    prefers_composition: impl FnOnce() -> bool,
+) -> bool {
+    if is_input_source_switch(key) {
+        return true;
+    }
+    if key.modifiers.platform || key.modifiers.control {
+        return false;
+    }
+    composing()
+        || (key
+            .key_char
+            .as_deref()
+            .is_some_and(|text| !text.chars().any(char::is_control))
+            && prefers_composition())
+}
+
+/// Control-Space cycles iPadOS input sources; Shift reverses the cycle.
+/// This remains the system's key even when a terminal or custom binding wants it.
+pub(crate) fn is_input_source_switch(key: &Keystroke) -> bool {
+    key.key == "space"
+        && key.modifiers.control
+        && !key.modifiers.platform
+        && !key.modifiers.alt
+        && !key.modifiers.function
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/src/key_routing/tests.rs b/src/key_routing/tests.rs
new file mode 100644
index 0000000..07a12a6
--- /dev/null
+++ b/src/key_routing/tests.rs
@@ -0,0 +1,39 @@
+use super::*;
+use crate::menu::Shortcut;
+
+fn key(source: &str) -> Keystroke {
+    Keystroke::parse(source).unwrap_or_else(|error| panic!("{source}: {error}"))
+}
+
+#[test]
+fn language_switch_reaches_uikit_before_terminal_and_custom_bindings() {
+    for source in ["ctrl-space", "ctrl-shift-space"] {
+        for composing in [false, true] {
+            assert!(
+                uikit_first(&key(source), || composing, || false),
+                "{source}, composing={composing}"
+            );
+        }
+    }
+}
+
+#[test]
+fn language_switch_cannot_be_installed_as_a_menu_key_command() {
+    for source in ["ctrl-space", "ctrl-shift-space"] {
+        assert!(Shortcut::new(&key(source)).is_none(), "{source}");
+    }
+}
+
+#[test]
+fn terminal_controls_and_app_shortcuts_keep_their_route() {
+    for source in ["ctrl-c", "ctrl-b", "ctrl-enter", "cmd-c", "ctrl-alt-space"] {
+        assert!(!uikit_first(&key(source), || false, || false), "{source}");
+    }
+    for source in ["enter", "escape", "left", "right", "up", "down", "space"] {
+        assert!(uikit_first(&key(source), || true, || true), "{source}");
+    }
+    let mut printable = key("n");
+    printable.key_char = Some("n".into());
+    assert!(uikit_first(&printable, || false, || true));
+    assert!(!uikit_first(&printable, || false, || false));
+}
