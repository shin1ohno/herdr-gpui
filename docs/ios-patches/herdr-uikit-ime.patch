new file mode 100644
index 0000000..3622cc2
--- /dev/null
+++ b/src/window/text_input/tests/composition_commit.rs
@@ -0,0 +1,135 @@
+use super::super::editing;
+use gpui::{
+    Bounds, Context, ElementInputHandler, EntityInputHandler, IntoElement, Pixels,
+    PlatformInputHandler, Point, Render, TestAppContext, UTF16Selection, Window, div,
+};
+use std::ops::Range;
+
+#[derive(Default)]
+struct Terminal {
+    marked: String,
+    commits: Vec<String>,
+}
+impl Render for Terminal {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        div()
+    }
+}
+impl EntityInputHandler for Terminal {
+    fn text_for_range(
+        &mut self,
+        range: Range<usize>,
+        adjusted: &mut Option<Range<usize>>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<String> {
+        assert_eq!(range, 0..self.marked.encode_utf16().count());
+        *adjusted = Some(range);
+        Some(self.marked.clone())
+    }
+    fn selected_text_range(
+        &mut self,
+        _: bool,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<UTF16Selection> {
+        let end = self.marked.encode_utf16().count();
+        Some(UTF16Selection {
+            range: end..end,
+            reversed: false,
+        })
+    }
+    fn marked_text_range(&self, _: &mut Window, _: &mut Context<Self>) -> Option<Range<usize>> {
+        (!self.marked.is_empty()).then(|| 0..self.marked.encode_utf16().count())
+    }
+    fn unmark_text(&mut self, _: &mut Window, _: &mut Context<Self>) {
+        self.marked.clear();
+    }
+    fn replace_text_in_range(
+        &mut self,
+        _: Option<Range<usize>>,
+        text: &str,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) {
+        self.marked.clear();
+        if !text.is_empty() {
+            self.commits.push(text.into());
+        }
+    }
+    fn replace_and_mark_text_in_range(
+        &mut self,
+        _: Option<Range<usize>>,
+        text: &str,
+        _: Option<Range<usize>>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) {
+        self.marked = text.into();
+    }
+    fn bounds_for_range(
+        &mut self,
+        _: Range<usize>,
+        bounds: Bounds<Pixels>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<Bounds<Pixels>> {
+        Some(bounds)
+    }
+    fn character_index_for_point(
+        &mut self,
+        _: Point<Pixels>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<usize> {
+        None
+    }
+}
+
+#[gpui::test]
+fn uikit_unmark_commits_a_terminal_composition_exactly_once(cx: &mut TestAppContext) {
+    let (view, cx) = cx.add_window_view(|_, _| Terminal::default());
+    let mut handler = cx.update(|window, cx| {
+        PlatformInputHandler::new(
+            window.to_async(cx),
+            Box::new(ElementInputHandler::new(Bounds::default(), view.clone())),
+        )
+    });
+    for text in ["日本", "𠮷野家"] {
+        handler.replace_and_mark_text_in_range(None, text, None);
+        assert_eq!(
+            handler.marked_text_range(),
+            Some(0..text.encode_utf16().count())
+        );
+        let count = view.read_with(cx, |view, _| view.commits.len());
+        editing::unmark_text(&mut handler);
+        assert_eq!(
+            &view.read_with(cx, |view, _| view.commits.clone())[count..],
+            &[text.to_owned()]
+        );
+        assert_eq!(handler.marked_text_range(), None);
+        editing::unmark_text(&mut handler);
+        assert_eq!(view.read_with(cx, |view, _| view.commits.len()), count + 1);
+    }
+}
+
+#[gpui::test]
+fn explicit_commit_then_unmark_does_not_duplicate_text(cx: &mut TestAppContext) {
+    let (view, cx) = cx.add_window_view(|_, _| Terminal::default());
+    let mut handler = cx.update(|window, cx| {
+        PlatformInputHandler::new(
+            window.to_async(cx),
+            Box::new(ElementInputHandler::new(Bounds::default(), view.clone())),
+        )
+    });
+    handler.replace_and_mark_text_in_range(None, "にほん", None);
+    handler.replace_text_in_range(None, "日本");
+    editing::unmark_text(&mut handler);
+    assert_eq!(view.read_with(cx, |view, _| view.commits.clone()), ["日本"]);
+    handler.replace_and_mark_text_in_range(None, "とりけし", None);
+    handler.replace_text_in_range(Some(0..4), "");
+    editing::unmark_text(&mut handler);
+    assert_eq!(view.read_with(cx, |view, _| view.commits.clone()), ["日本"]);
+}
+
+mod control_input;
diff --git a/src/window/text_input/tests/composition_commit/control_input.rs b/src/window/text_input/tests/composition_commit/control_input.rs
new file mode 100644
index 0000000..1ec0628
--- /dev/null
+++ b/src/window/text_input/tests/composition_commit/control_input.rs
@@ -0,0 +1,57 @@
+use super::*;
+use crate::window::text_input::keymap;
+
+#[gpui::test]
+fn return_insertion_commits_before_acknowledging_a_forwarded_key(cx: &mut TestAppContext) {
+    let (view, cx) = cx.add_window_view(|_, _| Terminal::default());
+    let mut handler = cx.update(|window, cx| {
+        PlatformInputHandler::new(
+            window.to_async(cx),
+            Box::new(ElementInputHandler::new(Bounds::default(), view.clone())),
+        )
+    });
+    for text in ["\r", "\n"] {
+        let key = keymap::control_keystroke(text).unwrap_or_else(|| panic!("return is a key"));
+        for forwarded in [false, true] {
+            let count = view.read_with(cx, |view, _| view.commits.len());
+            handler.replace_and_mark_text_in_range(None, "日本😀", None);
+            let dispatch = editing::control_input(&mut handler, &key, forwarded);
+            assert_eq!(
+                &view.read_with(cx, |view, _| view.commits.clone())[count..],
+                &["日本😀"]
+            );
+            assert!(
+                !dispatch,
+                "confirming composition must not also submit the terminal line"
+            );
+            assert_eq!(handler.marked_text_range(), None);
+            assert_eq!(
+                editing::control_input(&mut handler, &key, forwarded),
+                !forwarded
+            );
+            assert_eq!(view.read_with(cx, |view, _| view.commits.len()), count + 1);
+        }
+    }
+}
+
+#[gpui::test]
+fn escape_insertion_cancels_composition_without_text_or_terminal_escape(cx: &mut TestAppContext) {
+    let (view, cx) = cx.add_window_view(|_, _| Terminal::default());
+    let mut handler = cx.update(|window, cx| {
+        PlatformInputHandler::new(
+            window.to_async(cx),
+            Box::new(ElementInputHandler::new(Bounds::default(), view.clone())),
+        )
+    });
+    let key = keymap::control_keystroke("\u{1b}").unwrap_or_else(|| panic!("escape is a key"));
+    for forwarded in [false, true] {
+        handler.replace_and_mark_text_in_range(None, "とりけし😀", None);
+        assert!(!editing::control_input(&mut handler, &key, forwarded));
+        assert_eq!(handler.marked_text_range(), None);
+        assert!(view.read_with(cx, |view, _| view.commits.is_empty()));
+        assert_eq!(
+            editing::control_input(&mut handler, &key, forwarded),
+            !forwarded
+        );
+    }
+}
diff --git a/src/window/text_input/tests/composition_selection.rs b/src/window/text_input/tests/composition_selection.rs
new file mode 100644
index 0000000..269a10a
--- /dev/null
+++ b/src/window/text_input/tests/composition_selection.rs
@@ -0,0 +1,131 @@
+use super::super::editing;
+use gpui::{
+    Bounds, Context, ElementInputHandler, EntityInputHandler, IntoElement, Pixels,
+    PlatformInputHandler, Point, Render, TestAppContext, UTF16Selection, Window, div,
+};
+use std::ops::Range;
+
+struct Document {
+    text: Vec<u16>,
+    marked: Option<Range<usize>>,
+    selection: Range<usize>,
+}
+
+impl Render for Document {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        div()
+    }
+}
+
+impl EntityInputHandler for Document {
+    fn text_for_range(
+        &mut self,
+        range: Range<usize>,
+        adjusted: &mut Option<Range<usize>>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<String> {
+        *adjusted = Some(range.clone());
+        String::from_utf16(self.text.get(range)?).ok()
+    }
+    fn selected_text_range(
+        &mut self,
+        _: bool,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<UTF16Selection> {
+        Some(UTF16Selection {
+            range: self.selection.clone(),
+            reversed: false,
+        })
+    }
+    fn set_selected_text_range(
+        &mut self,
+        range: Range<usize>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) {
+        self.selection = range;
+    }
+    fn marked_text_range(&self, _: &mut Window, _: &mut Context<Self>) -> Option<Range<usize>> {
+        self.marked.clone()
+    }
+    fn unmark_text(&mut self, _: &mut Window, _: &mut Context<Self>) {
+        self.marked = None;
+    }
+    fn replace_text_in_range(
+        &mut self,
+        range: Option<Range<usize>>,
+        text: &str,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) {
+        let range = range.unwrap_or_else(|| self.selection.clone());
+        let end = range.start + text.encode_utf16().count();
+        self.text.splice(range, text.encode_utf16());
+        self.selection = end..end;
+        self.marked = None;
+    }
+    fn replace_and_mark_text_in_range(
+        &mut self,
+        _: Option<Range<usize>>,
+        _: &str,
+        _: Option<Range<usize>>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) {
+        panic!("this test starts with a composition already in the document");
+    }
+    fn bounds_for_range(
+        &mut self,
+        _: Range<usize>,
+        bounds: Bounds<Pixels>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<Bounds<Pixels>> {
+        Some(bounds)
+    }
+    fn character_index_for_point(
+        &mut self,
+        _: Point<Pixels>,
+        _: &mut Window,
+        _: &mut Context<Self>,
+    ) -> Option<usize> {
+        None
+    }
+}
+
+#[gpui::test]
+fn unmark_preserves_a_document_caret_and_emoji_selection(cx: &mut TestAppContext) {
+    let (view, cx) = cx.add_window_view(|_, _| Document {
+        text: "前😀日本後".encode_utf16().collect(),
+        marked: Some(1..5),
+        selection: 1..3,
+    });
+    let mut handler = cx.update(|window, cx| {
+        PlatformInputHandler::new(
+            window.to_async(cx),
+            Box::new(ElementInputHandler::new(Bounds::default(), view.clone())),
+        )
+    });
+    for selection in [1..3, 4..4] {
+        cx.update(|_, cx| {
+            view.update(cx, |view, _| {
+                view.marked = Some(1..5);
+                view.selection = selection.clone();
+            })
+        });
+        editing::unmark_text(&mut handler);
+        assert_eq!(handler.marked_text_range(), None);
+        assert_eq!(
+            handler
+                .selected_text_range(false)
+                .map(|selection| selection.range),
+            Some(selection)
+        );
+        assert_eq!(
+            view.read_with(cx, |view, _| view.text.clone()),
+            "前😀日本後".encode_utf16().collect::<Vec<_>>()
+        );
+    }
+}
