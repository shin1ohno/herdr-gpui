<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>be.ohno.herdr-ios-runner.example</string>
<key>ProgramArguments</key><array><string>/ABSOLUTE/PATH/actions-runner/run.sh</string></array>
<key>WorkingDirectory</key><string>/ABSOLUTE/PATH/actions-runner</string>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/ABSOLUTE/HOME/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>/ABSOLUTE/PATH/runner.stdout.log</string>
<key>StandardErrorPath</key><string>/ABSOLUTE/PATH/runner.stderr.log</string>
</dict></plist>
